{
  "name": "lunar-frontier",
  "version": "1.0.0",
  "description": "Lunar Frontier Multiplayer Economy and Subterranean Simulation",
  "main": "index.ts",
  "scripts": {
    "start": "PORT=3030 HOST=0.0.0.0 npx tsx src/server/index.ts",
    "server": "PORT=3030 HOST=0.0.0.0 npx tsx src/server/index.ts",
    "client": "vite --host 0.0.0.0 --port 5174",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "smoke:world": "node --no-warnings scripts/smoke-lunarworld.ts",
    "smoke:transport": "npx tsx scripts/smoke-transport-lander.ts",
    "smoke:intro": "npx tsx scripts/smoke-intro-experience.ts",
    "smoke:market": "npx tsx scripts/smoke-market-and-rails.ts",
    "smoke:client": "npx tsx scripts/smoke-client-app.ts",
    "smoke:xcorp-heist": "npx tsx scripts/smoke-x-corp-heist.ts",
    "smoke:mass-accelerator": "npx tsx scripts/smoke-mass-accelerator.ts",
    "smoke:radio-tower": "npx tsx scripts/smoke-radio-tower.ts",
    "smoke:eva-cleanup": "npx tsx scripts/smoke-eva-cleanup.ts",
    "lunar:smoke:cleanup": "npx tsx scripts/smoke-general-cleanup.ts",
    "verify:surface": "npx tsx tests/verify-surface-rendering.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.0",
    "@babylonjs/gui": "^9.26.0",
    "@babylonjs/materials": "^9.26.0",
    "express": "^4.21.0",
    "fastify": "^5.12.3",
    "sqlite3": "^5.1.0",
    "three": "^0.168.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
